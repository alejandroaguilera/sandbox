# Conexión a Postgres (Dokploy: host = appName del servicio de base de datos)
DATABASE_URL=
NODE_ENV=production
# API de Anthropic (solo servidor)
ANTHROPIC_API_KEY=
# Modelo Claude Sonnet vigente con visión, ej. claude-sonnet-5
AI_MODEL=
# Contraseña de /admin
ADMIN_PASSWORD=
# Llave compartida app <-> n8n (openssl rand -hex 24), va en el header x-sandbox-key
SANDBOX_SHARED_KEY=
# direct | n8n  (se puede cambiar en caliente desde /admin)
FLOW_MODE=direct
N8N_WEBHOOK_URL=https://sandbox-n8n.mrhapps.mx/webhook/requisicion
PUBLIC_BASE_URL=https://sandbox.mrhapps.mx
