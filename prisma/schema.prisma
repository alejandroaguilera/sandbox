generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Dimension {
  DIRECCION
  COMERCIAL
  OPERACION
  ADMIN_FINANZAS
  PERSONAS
  EXPERIENCIA_DIGITAL
}

enum Tamano {
  T1_10
  T11_50
  T51_250
  T250_MAS
}

enum EstadoReq {
  PENDIENTE
  APROBADA
  RECHAZADA
}

model SalaRespuesta {
  id        String    @id @default(cuid())
  dimension Dimension
  tamano    Tamano
  proceso   String    @db.VarChar(160)
  oculto    Boolean   @default(false)
  createdAt DateTime  @default(now())

  @@index([createdAt])
}

model Lead {
  id                String   @id @default(cuid())
  nombre            String
  empresa           String
  correo            String
  whatsapp          String?
  tamano            Tamano
  giro              String?
  procesoDoloroso   String?
  quiereDiagnostico Boolean  @default(false)
  consentimiento    Boolean
  createdAt         DateTime @default(now())
}

model Requisicion {
  id              String        @id @default(cuid())
  folio           Int           @unique
  solicitante     String
  area            String
  articulo        String
  cantidad        Int
  montoEstimado   Decimal       @db.Decimal(12, 2)
  motivo          String?
  estado          EstadoReq     @default(PENDIENTE)
  tokenAprobacion String        @unique
  resumeUrl       String?
  createdAt       DateTime      @default(now())
  resueltaAt      DateTime?
  eventos         EventoFlujo[]
}

model EventoFlujo {
  id            String       @id @default(cuid())
  requisicionId String?
  requisicion   Requisicion? @relation(fields: [requisicionId], references: [id], onDelete: Cascade)
  paso          String
  detalle       String?
  createdAt     DateTime     @default(now())

  @@index([createdAt])
}

model Correo {
  id             String   @id @default(cuid())
  para           String
  asunto         String
  cuerpo         String
  accionAprobar  String?
  accionRechazar String?
  leido          Boolean  @default(false)
  createdAt      DateTime @default(now())
}

model Gasto {
  id        String    @id @default(cuid())
  fecha     DateTime?
  proveedor String?
  rfc       String?
  subtotal  Decimal?  @db.Decimal(12, 2)
  iva       Decimal?  @db.Decimal(12, 2)
  total     Decimal?  @db.Decimal(12, 2)
  categoria String
  confianza Float
  revisar   Boolean
  origen    String // "ia" | "error" | "ejemplo"
  createdAt DateTime  @default(now())
}

model Config {
  clave String @id
  valor String
}

// Demo 3: empresa ficticia
model Cliente {
  id       Int       @id
  nombre   String
  giro     String
  ciudad   String
  ventas   Venta[]
  facturas Factura[]
}

model Producto {
  id        Int     @id
  nombre    String
  categoria String
  precio    Decimal @db.Decimal(12, 2)
  costo     Decimal @db.Decimal(12, 2)
  ventas    Venta[]
}

model Venta {
  id         Int      @id @default(autoincrement())
  fecha      DateTime
  clienteId  Int
  productoId Int
  cantidad   Int
  precioUnit Decimal  @db.Decimal(12, 2)
  costoUnit  Decimal  @db.Decimal(12, 2)
  cliente    Cliente  @relation(fields: [clienteId], references: [id])
  producto   Producto @relation(fields: [productoId], references: [id])

  @@index([fecha])
  @@index([clienteId])
}

model Factura {
  id        Int       @id @default(autoincrement())
  clienteId Int
  fecha     DateTime
  vence     DateTime
  monto     Decimal   @db.Decimal(12, 2)
  pagadaAt  DateTime?
  cliente   Cliente   @relation(fields: [clienteId], references: [id])

  @@index([clienteId])
}

// Demo 4: agenda de servicios (taller ficticio). fecha + minutos en hora local del negocio,
// sin zonas horarias de por medio.
model Reserva {
  id            String   @id
  folio         Int?     @unique // solo las reservas en vivo llevan folio
  fecha         String   @db.VarChar(10) // YYYY-MM-DD
  inicioMin     Int
  finMin        Int
  bahia         Int
  servicioId    Int
  clienteNombre String   @db.VarChar(80)
  vehiculo      String?  @db.VarChar(80)
  origen        String // "ejemplo" | "vivo"
  createdAt     DateTime @default(now())

  @@index([fecha])
}

// ---------- Curso "IA desde cero" (/cursoIA) ----------
// Cada impartición es una sesión. No existe tabla de mensajes de chat: es intencional.
model CursoSesion {
  id         String   @id @default(cuid())
  codigo     String   @unique // p. ej. "garza-rechy-2026-11"
  cliente    String
  fecha      DateTime
  wifi       String? // red de invitados que se muestra antes de empezar
  activa     Boolean  @default(false)
  momentoId  String? // momento "Ahora"; null = aún no empieza
  iaPausada  Boolean  @default(false)
  sinIA      Boolean  @default(false) // "Modo sin IA": solo Copiar
  proyector  String   @default("qr") // "qr" | "v:<clave>" | "semaforo" | "preguntas"
  epoca      Int      @default(0) // sube en cada reinicio: los celulares borran su estado local
  createdAt  DateTime @default(now())
}

model CursoVotacion {
  id       String  @id @default(cuid())
  sesionId String
  clave    String // "sondeo", "frase", "area", "sorpresa"
  abierta  Boolean @default(false)

  @@unique([sesionId, clave])
}

model CursoVoto {
  id          String   @id @default(cuid())
  votacionId  String
  dispositivo String // cookie anónima
  pregunta    String   @default("") // para el sondeo de 4 preguntas
  valor       String   @db.VarChar(120)
  oculto      Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@unique([votacionId, dispositivo, pregunta])
}

model CursoPregunta {
  id         String   @id @default(cuid())
  sesionId   String
  texto      String   @db.VarChar(200)
  votos      Int      @default(0)
  oculta     Boolean  @default(false)
  respondida Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([sesionId, createdAt])
}

model CursoPreguntaVoto {
  preguntaId  String
  dispositivo String

  @@id([preguntaId, dispositivo])
}

model CursoSemaforo {
  id          String  @id @default(cuid())
  sesionId    String
  dispositivo String
  tarjeta     String
  acierto     Boolean

  @@unique([sesionId, dispositivo, tarjeta])
}

// Solo conteos, NUNCA contenido.
model CursoUsoIA {
  id            String   @id @default(cuid())
  sesionId      String
  dispositivo   String
  mensajes      Int      @default(0)
  tokensEntrada Int      @default(0)
  tokensSalida  Int      @default(0)
  updatedAt     DateTime @updatedAt

  @@unique([sesionId, dispositivo])
}

// Gasto estimado por día (para el tope diario). Solo conteos.
model CursoGastoDia {
  dia           String @id @db.VarChar(10) // YYYY-MM-DD (UTC)
  mensajes      Int    @default(0)
  tokensEntrada Int    @default(0)
  tokensSalida  Int    @default(0)
}

model CursoEvaluacion {
  id          String   @id @default(cuid())
  sesionId    String
  dispositivo String
  utilidad    Int
  valioso     String?  @db.VarChar(300)
  interes     String?
  createdAt   DateTime @default(now())

  @@unique([sesionId, dispositivo])
}
